info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (4ms) [Parameters=[p0='?' (DbType = DateTime)], CommandType='Text', CommandTimeout='30']
      
                          SELECT 
                              t.id AS "TripId",
                              g.lat AS "Lat",
                              g.lng AS "Lng",
                              g.server_received_at AS "ServerReceivedAt"
                          FROM transport.trips t
                          LEFT JOIN LATERAL (
                              SELECT 
                                  lat,
                                  lng,
                                  server_received_at
                              FROM transport.gps_logs g
                              WHERE g.trip_id = t.id
                              ORDER BY g.device_timestamp DESC
                              LIMIT 1
                          ) g ON true
                          WHERE t.status = 'Active'
                            AND (
                                  g.server_received_at IS NULL
                                  OR g.server_received_at < @p0
                            )
